{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "package.schema.json",
  "title": "Package",
  "description": "Output of the package skill: what the owner copies when uploading by hand (design doc section 6). The app never posts anything itself.",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "description", "hashtags", "cover_frame_s"],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 5000
    },
    "hashtags": {
      "type": "array",
      "minItems": 1,
      "maxItems": 15,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^#[A-Za-z0-9_]{1,50}$" }
    },
    "cover_frame_s": {
      "description": "The moment of the video to use as the cover frame, in seconds from the start.",
      "type": "number",
      "minimum": 0,
      "maximum": 600
    }
  }
}
