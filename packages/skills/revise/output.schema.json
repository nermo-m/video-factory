{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Revision",
  "description": "Output of the revise skill: a minimal JSON Patch to the episode spec (design doc section 6).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "patch",
    "summary"
  ],
  "properties": {
    "summary": {
      "type": "string",
      "pattern": "\\S",
      "maxLength": 600
    },
    "patch": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "op",
          "path"
        ],
        "properties": {
          "op": {
            "enum": [
              "add",
              "remove",
              "replace"
            ]
          },
          "path": {
            "type": "string",
            "pattern": "^/"
          },
          "value": {}
        }
      }
    }
  }
}
