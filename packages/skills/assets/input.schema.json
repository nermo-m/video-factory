{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Assets input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "spec",
    "library",
    "style_block"
  ],
  "properties": {
    "idea": {
      "description": "The owner's own text for this episode, as it was typed in. What it fixes (lines, shots, characters, a style) is kept.",
      "type": "string"
    },
    "spec": {
      "type": "object",
      "required": [
        "episode_id",
        "scenes",
        "assets"
      ]
    },
    "library": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "key",
          "kind"
        ]
      }
    },
    "style_block": {
      "type": "string"
    }
  }
}
