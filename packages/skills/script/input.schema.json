{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Script input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "brief",
    "claims",
    "target_duration_s"
  ],
  "properties": {
    "brief": {
      "type": "object",
      "required": [
        "angle",
        "lesson",
        "audience",
        "titles"
      ]
    },
    "claims": {
      "type": "object",
      "required": [
        "claims"
      ]
    },
    "target_duration_s": {
      "type": "integer",
      "minimum": 15,
      "maximum": 180
    },
    "voice_speed": {
      "type": "number",
      "minimum": 0.5,
      "maximum": 2.0
    }
  }
}
