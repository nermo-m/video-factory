{
  "name": "video-factory",
  "version": "0.1.0",
  "private": true,
  "description": "Repository-level JavaScript tooling for Video Factory Studio.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint --max-warnings 0 .",
    "test": "node --test \"tools/tests/**/*.test.mjs\" && pnpm --filter web check:api",
    "progress": "node tools/progress-server.js",
    "progress:sync": "node tools/sync-progress.mjs",
    "typecheck": "pnpm --filter web typecheck"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2"
  }
}
