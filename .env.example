# Copy this file to .env and adjust. Never commit .env.
# Placeholders only: no real keys, passwords or tokens belong in this file.

# --- Provider mode (design doc section 3.4) ---------------------------------
# demo: recorded responses and bundled samples, no keys, no GPU, no cost (default)
# subscription: the owner's Claude and ChatGPT plans through the host CLI bridge
# api: paid Anthropic and OpenAI APIs. Also needs the "Use paid APIs" switch in Settings
PROVIDER_MODE=demo

# Development spending cap in US dollars. 0 means mocks and recordings only.
DEV_MAX_SPEND_USD=0

# --- Database and storage ----------------------------------------------------
POSTGRES_USER=vfs
POSTGRES_PASSWORD=change-me
POSTGRES_DB=vfs
# Host port for the database, bound to 127.0.0.1 only. 5433 avoids a local Postgres on 5432.
DB_HOST_PORT=5433
# Host ports of the api and the interface, bound to 127.0.0.1 only. Change them when
# something else on this PC uses 8000 or 3000.
API_HOST_PORT=8000
WEB_HOST_PORT=3000
# DATABASE_URL is built by docker-compose.yml from the values above. Set it yourself
# only when you run a service outside Docker, for example:
# DATABASE_URL=postgresql+psycopg://vfs:change-me@127.0.0.1:5433/vfs
# Storage root inside the containers (a named Docker volume)
DATA_DIR=/data
# Host folder that receives finished videos with their caption files
EXPORT_DIR=./export

# --- Subscription mode: host CLI bridge ---------------------------------------
# The bridge runs on this PC, outside Docker: `make up` starts it in subscription mode.
# It listens on 127.0.0.1 only. See tools/cli_bridge/README.md.
CLI_BRIDGE_URL=http://host.docker.internal:8189
# Port of the bridge. Change it together with the address above.
CLI_BRIDGE_PORT=8189
# The two programs, as a name on the PATH or a full path. Empty means claude and codex.
CLAUDE_BIN=
CODEX_BIN=
# Optional model names passed to the command line tools
CLAUDE_CLI_MODEL=
CODEX_CLI_MODEL=
# Minutes between automatic provider limit checks
LIMIT_CHECK_MINUTES=10

# --- API mode: paid providers (leave empty unless you switch the mode) --------
ANTHROPIC_API_KEY=
# Empty means claude-opus-5-5. Only models with a price in the app's table are accepted.
ANTHROPIC_MODEL=
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=

# --- Local generation ---------------------------------------------------------
# ComfyUI runs on the Windows host, outside Docker
COMFYUI_URL=http://host.docker.internal:8188
# Kokoro voice model files, downloaded by `make models` into the models volume.
# Docker Compose sets these two itself. They matter only outside Docker.
KOKORO_MODEL_PATH=/models/kokoro/kokoro.onnx
KOKORO_VOICES_PATH=/models/kokoro/voices.bin

# --- Worker ---------------------------------------------------------------------
CPU_WORKERS=2
LOG_LEVEL=info

# --- Agents ---------------------------------------------------------------------
CRITIC_ENABLED=true
CRITIC_MAX_ROUNDS=2
CRITIC_MAX_COST_USD=0.50
AUTOPILOT_MAX_COST_USD=3.00
AUTOPILOT_MAX_MINUTES=90

# --- Optional phone access on the home network (off by default) ----------------
# LAN_ACCESS=true binds web and api to the local network and requires APP_PASSWORD
LAN_ACCESS=false
APP_PASSWORD=
