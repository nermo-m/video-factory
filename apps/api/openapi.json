{
  "components": {
    "schemas": {
      "Check": {
        "properties": {
          "message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "What is wrong and what to do.",
            "title": "Message"
          },
          "status": {
            "$ref": "#/components/schemas/CheckStatus"
          }
        },
        "required": [
          "status"
        ],
        "title": "Check",
        "type": "object"
      },
      "CheckStatus": {
        "enum": [
          "ok",
          "error",
          "offline",
          "not_needed"
        ],
        "title": "CheckStatus",
        "type": "string"
      },
      "ErrorBody": {
        "properties": {
          "code": {
            "description": "Stable machine-readable reason, for example not_found.",
            "title": "Code",
            "type": "string"
          },
          "details": {
            "additionalProperties": true,
            "title": "Details",
            "type": "object"
          },
          "message": {
            "description": "What happened and what to do next, in plain words.",
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorBody",
        "type": "object"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "HealthCheckResults": {
        "properties": {
          "comfyui": {
            "$ref": "#/components/schemas/Check"
          },
          "database": {
            "$ref": "#/components/schemas/Check"
          },
          "storage": {
            "$ref": "#/components/schemas/Check"
          }
        },
        "required": [
          "database",
          "storage",
          "comfyui"
        ],
        "title": "HealthCheckResults",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "checks": {
            "$ref": "#/components/schemas/HealthCheckResults"
          },
          "demo_mode": {
            "description": "True when PROVIDER_MODE is demo.",
            "title": "Demo Mode",
            "type": "boolean"
          },
          "provider_mode": {
            "enum": [
              "demo",
              "subscription",
              "api"
            ],
            "title": "Provider Mode",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/HealthStatus"
          }
        },
        "required": [
          "status",
          "provider_mode",
          "demo_mode",
          "checks"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "HealthStatus": {
        "enum": [
          "ok",
          "unavailable"
        ],
        "title": "HealthStatus",
        "type": "string"
      },
      "SettingsResponse": {
        "properties": {
          "paid_apis_active": {
            "description": "True only when the mode is api and the switch is on.",
            "title": "Paid Apis Active",
            "type": "boolean"
          },
          "paid_apis_message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Why paid APIs are off, in plain words. Null when they are on.",
            "title": "Paid Apis Message"
          },
          "provider_mode": {
            "description": "demo, subscription or api. Set by PROVIDER_MODE at start-up, read-only.",
            "title": "Provider Mode",
            "type": "string"
          },
          "secrets": {
            "additionalProperties": {
              "type": "boolean"
            },
            "description": "Which secret environment variables are set. Never their values.",
            "title": "Secrets",
            "type": "object"
          },
          "use_paid_apis": {
            "description": "The owner's \"Use paid APIs\" switch.",
            "title": "Use Paid Apis",
            "type": "boolean"
          }
        },
        "required": [
          "provider_mode",
          "use_paid_apis",
          "paid_apis_active",
          "paid_apis_message",
          "secrets"
        ],
        "title": "SettingsResponse",
        "type": "object"
      },
      "SettingsUpdate": {
        "additionalProperties": false,
        "properties": {
          "use_paid_apis": {
            "title": "Use Paid Apis",
            "type": "boolean"
          }
        },
        "required": [
          "use_paid_apis"
        ],
        "title": "SettingsUpdate",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Local API for the Video Factory Studio interface.",
    "title": "Video Factory Studio API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/health": {
      "get": {
        "operationId": "get_health",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "The request is not valid."
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unexpected server error."
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Database or storage is down."
          }
        },
        "summary": "Liveness, database, storage, ComfyUI reachability and demo mode",
        "tags": [
          "system"
        ]
      }
    },
    "/api/v1/settings": {
      "get": {
        "operationId": "get_settings",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SettingsResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "The request is not valid."
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unexpected server error."
          }
        },
        "summary": "Non-secret settings and which secrets are present",
        "tags": [
          "settings"
        ]
      },
      "put": {
        "operationId": "put_settings",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SettingsUpdate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SettingsResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "The request body could not be read."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "The request is not valid."
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unexpected server error."
          }
        },
        "summary": "Turn the \"Use paid APIs\" switch on or off",
        "tags": [
          "settings"
        ]
      }
    }
  }
}
