{
  "components": {
    "schemas": {
      "Billing": {
        "enum": [
          "demo",
          "plan",
          "api"
        ],
        "title": "Billing",
        "type": "string"
      },
      "BudgetOut": {
        "properties": {
          "calls_5h": {
            "title": "Calls 5H",
            "type": "integer"
          },
          "calls_7d": {
            "title": "Calls 7D",
            "type": "integer"
          },
          "images_5h": {
            "title": "Images 5H",
            "type": "integer"
          },
          "images_7d": {
            "title": "Images 7D",
            "type": "integer"
          },
          "usd_5h": {
            "title": "Usd 5H",
            "type": "string"
          },
          "usd_7d": {
            "title": "Usd 7D",
            "type": "string"
          }
        },
        "required": [
          "calls_5h",
          "calls_7d",
          "images_5h",
          "images_7d",
          "usd_5h",
          "usd_7d"
        ],
        "title": "BudgetOut",
        "type": "object"
      },
      "BudgetUpdate": {
        "additionalProperties": false,
        "description": "Numbers that are left out keep their value.",
        "properties": {
          "calls_5h": {
            "anyOf": [
              {
                "maximum": 100000.0,
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Calls 5H"
          },
          "calls_7d": {
            "anyOf": [
              {
                "maximum": 100000.0,
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Calls 7D"
          },
          "images_5h": {
            "anyOf": [
              {
                "maximum": 100000.0,
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Images 5H"
          },
          "images_7d": {
            "anyOf": [
              {
                "maximum": 100000.0,
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Images 7D"
          },
          "usd_5h": {
            "anyOf": [
              {
                "pattern": "^[0-9]{1,6}(\\.[0-9]{1,4})?$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Usd 5H"
          },
          "usd_7d": {
            "anyOf": [
              {
                "pattern": "^[0-9]{1,6}(\\.[0-9]{1,4})?$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Usd 7D"
          }
        },
        "title": "BudgetUpdate",
        "type": "object"
      },
      "Check": {
        "properties": {
          "message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "What is wrong and what to do.",
            "title": "Message"
          },
          "status": {
            "$ref": "#/components/schemas/CheckStatus"
          }
        },
        "required": [
          "status"
        ],
        "title": "Check",
        "type": "object"
      },
      "CheckStatus": {
        "enum": [
          "ok",
          "error",
          "offline",
          "not_needed"
        ],
        "title": "CheckStatus",
        "type": "string"
      },
      "ContinueRequest": {
        "additionalProperties": false,
        "properties": {
          "episode_id": {
            "format": "uuid",
            "title": "Episode Id",
            "type": "string"
          }
        },
        "required": [
          "episode_id"
        ],
        "title": "ContinueRequest",
        "type": "object"
      },
      "ErrorBody": {
        "properties": {
          "code": {
            "description": "Stable machine-readable reason, for example not_found.",
            "title": "Code",
            "type": "string"
          },
          "details": {
            "additionalProperties": true,
            "title": "Details",
            "type": "object"
          },
          "message": {
            "description": "What happened and what to do next, in plain words.",
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorBody",
        "type": "object"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "HealthCheckResults": {
        "properties": {
          "comfyui": {
            "$ref": "#/components/schemas/Check"
          },
          "database": {
            "$ref": "#/components/schemas/Check"
          },
          "storage": {
            "$ref": "#/components/schemas/Check"
          }
        },
        "required": [
          "database",
          "storage",
          "comfyui"
        ],
        "title": "HealthCheckResults",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "checks": {
            "$ref": "#/components/schemas/HealthCheckResults"
          },
          "demo_mode": {
            "description": "True when PROVIDER_MODE is demo.",
            "title": "Demo Mode",
            "type": "boolean"
          },
          "provider_mode": {
            "enum": [
              "demo",
              "subscription",
              "api"
            ],
            "title": "Provider Mode",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/HealthStatus"
          }
        },
        "required": [
          "status",
          "provider_mode",
          "demo_mode",
          "checks"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "HealthStatus": {
        "enum": [
          "ok",
          "unavailable"
        ],
        "title": "HealthStatus",
        "type": "string"
      },
      "Provider": {
        "description": "Who answered a model call. `demo` is the recorded-response provider.",
        "enum": [
          "demo",
          "claude_plan",
          "chatgpt_plan",
          "anthropic_api",
          "openai_api"
        ],
        "title": "Provider",
        "type": "string"
      },
      "ProviderOut": {
        "properties": {
          "billing": {
            "$ref": "#/components/schemas/Billing",
            "description": "demo, plan or api."
          },
          "budget": {
            "$ref": "#/components/schemas/BudgetOut"
          },
          "budget_used": {
            "description": "Share of the budget used, 1.0 is all of it.",
            "title": "Budget Used",
            "type": "number"
          },
          "id": {
            "$ref": "#/components/schemas/Provider"
          },
          "last_checked_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Checked At"
          },
          "last_error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "What the last check or limit event said.",
            "title": "Last Error"
          },
          "limited_until": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "When a limit resets, if the tool said so.",
            "title": "Limited Until"
          },
          "state": {
            "$ref": "#/components/schemas/ProviderState",
            "description": "ok, near_budget, paused_by_budget or limited."
          },
          "state_source": {
            "$ref": "#/components/schemas/StatusSource",
            "description": "tool: a tool reported the limit. app: follows from this app's own count."
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "usage": {
            "$ref": "#/components/schemas/WindowsOut"
          },
          "usage_source": {
            "const": "app",
            "description": "Usage is counted by this app. It is not the plan's remaining quota.",
            "title": "Usage Source",
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "billing",
          "state",
          "state_source",
          "limited_until",
          "last_checked_at",
          "last_error",
          "usage",
          "usage_source",
          "budget",
          "budget_used"
        ],
        "title": "ProviderOut",
        "type": "object"
      },
      "ProviderState": {
        "enum": [
          "ok",
          "near_budget",
          "paused_by_budget",
          "limited"
        ],
        "title": "ProviderState",
        "type": "string"
      },
      "ProvidersResponse": {
        "properties": {
          "providers": {
            "items": {
              "$ref": "#/components/schemas/ProviderOut"
            },
            "title": "Providers",
            "type": "array"
          }
        },
        "required": [
          "providers"
        ],
        "title": "ProvidersResponse",
        "type": "object"
      },
      "SettingsResponse": {
        "properties": {
          "paid_apis_active": {
            "description": "True only when the mode is api and the switch is on.",
            "title": "Paid Apis Active",
            "type": "boolean"
          },
          "paid_apis_message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Why paid APIs are off, in plain words. Null when they are on.",
            "title": "Paid Apis Message"
          },
          "provider_mode": {
            "description": "demo, subscription or api. Set by PROVIDER_MODE at start-up, read-only.",
            "title": "Provider Mode",
            "type": "string"
          },
          "secrets": {
            "additionalProperties": {
              "type": "boolean"
            },
            "description": "Which secret environment variables are set. Never their values.",
            "title": "Secrets",
            "type": "object"
          },
          "use_paid_apis": {
            "description": "The owner's \"Use paid APIs\" switch.",
            "title": "Use Paid Apis",
            "type": "boolean"
          }
        },
        "required": [
          "provider_mode",
          "use_paid_apis",
          "paid_apis_active",
          "paid_apis_message",
          "secrets"
        ],
        "title": "SettingsResponse",
        "type": "object"
      },
      "SettingsUpdate": {
        "additionalProperties": false,
        "properties": {
          "use_paid_apis": {
            "title": "Use Paid Apis",
            "type": "boolean"
          }
        },
        "required": [
          "use_paid_apis"
        ],
        "title": "SettingsUpdate",
        "type": "object"
      },
      "StatusSource": {
        "description": "Whether a provider status came from the tool itself or from this app's own count.",
        "enum": [
          "tool",
          "app"
        ],
        "title": "StatusSource",
        "type": "string"
      },
      "UsageOut": {
        "properties": {
          "calls": {
            "description": "Text calls in the window.",
            "title": "Calls",
            "type": "integer"
          },
          "cost_usd": {
            "description": "Real cost for a paid provider, 0 for a plan.",
            "title": "Cost Usd",
            "type": "string"
          },
          "images": {
            "title": "Images",
            "type": "integer"
          },
          "input_tokens": {
            "title": "Input Tokens",
            "type": "integer"
          },
          "output_tokens": {
            "title": "Output Tokens",
            "type": "integer"
          }
        },
        "required": [
          "calls",
          "images",
          "input_tokens",
          "output_tokens",
          "cost_usd"
        ],
        "title": "UsageOut",
        "type": "object"
      },
      "WindowsOut": {
        "properties": {
          "five_hours": {
            "$ref": "#/components/schemas/UsageOut"
          },
          "seven_days": {
            "$ref": "#/components/schemas/UsageOut"
          }
        },
        "required": [
          "five_hours",
          "seven_days"
        ],
        "title": "WindowsOut",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Local API for the Video Factory Studio interface.",
    "title": "Video Factory Studio API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/health": {
      "get": {
        "operationId": "get_health",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "The request is not valid."
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unexpected server error."
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Database or storage is down."
          }
        },
        "summary": "Liveness, database, storage, ComfyUI reachability and demo mode",
        "tags": [
          "system"
        ]
      }
    },
    "/api/v1/providers": {
      "get": {
        "operationId": "get_providers",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProvidersResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "The request is not valid."
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unexpected server error."
          }
        },
        "summary": "Each provider with its state, usage and budget",
        "tags": [
          "providers"
        ]
      }
    },
    "/api/v1/providers/check": {
      "post": {
        "operationId": "post_providers_check",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProvidersResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "The request is not valid."
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "The limits were checked less than 30 seconds ago."
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unexpected server error."
          }
        },
        "summary": "Check the limits of every provider now",
        "tags": [
          "providers"
        ]
      }
    },
    "/api/v1/providers/{provider}/budget": {
      "put": {
        "operationId": "put_provider_budget",
        "parameters": [
          {
            "in": "path",
            "name": "provider",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/Provider"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BudgetUpdate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProvidersResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "The request body could not be read."
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "The provider is not used in this mode."
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "The numbers contradict each other."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "The request is not valid."
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unexpected server error."
          }
        },
        "summary": "Set the owner's soft budget for a provider",
        "tags": [
          "providers"
        ]
      }
    },
    "/api/v1/providers/{provider}/continue": {
      "post": {
        "operationId": "post_provider_continue",
        "parameters": [
          {
            "in": "path",
            "name": "provider",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/Provider"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ContinueRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProvidersResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "The request body could not be read."
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "The provider is not used in this mode, or the episode does not exist."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "The request is not valid."
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unexpected server error."
          }
        },
        "summary": "\"Continue anyway\": let one episode pass a budget pause of this provider",
        "tags": [
          "providers"
        ]
      }
    },
    "/api/v1/settings": {
      "get": {
        "operationId": "get_settings",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SettingsResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "The request is not valid."
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unexpected server error."
          }
        },
        "summary": "Non-secret settings and which secrets are present",
        "tags": [
          "settings"
        ]
      },
      "put": {
        "operationId": "put_settings",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SettingsUpdate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SettingsResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "The request body could not be read."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "The request is not valid."
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unexpected server error."
          }
        },
        "summary": "Turn the \"Use paid APIs\" switch on or off",
        "tags": [
          "settings"
        ]
      }
    }
  }
}
